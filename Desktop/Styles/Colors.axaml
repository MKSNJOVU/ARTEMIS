    <StreamGeometry x:Key="IconFolder">M3,6.5 A1.5,1.5 0 0 1 4.5,5 H9 L11,7.5 H19.5 A1.5,1.5 0 0 1 21,9 V18.5 A1.5,1.5 0 0 1 19.5,20 H4.5 A1.5,1.5 0 0 1 3,18.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconWipe">M5,7 H19 M9,7 V5.5 A1.5,1.5 0 0 1 10.5,4 H13.5 A1.5,1.5 0 0 1 15,5.5 V7 M8,7 L8.6,19 A1.5,1.5 0 0 0 10.1,20.4 H13.9 A1.5,1.5 0 0 0 15.4,19 L16,7</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M10.5,4 A6.5,6.5 0 1 1 10.5,17 A6.5,6.5 0 1 1 10.5,4 M15.5,15.5 L20,20</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
    <StreamGeometry x:Key="IconReveal">M4,12 C6.5,7.5 9.5,5.5 12,5.5 C14.5,5.5 17.5,7.5 20,12 C17.5,16.5 14.5,18.5 12,18.5 C9.5,18.5 6.5,16.5 4,12 M12,9.5 A2.5,2.5 0 1 1 12,14.5 A2.5,2.5 0 1 1 12,9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M7,3 H14 L19,8 V21 H7 Z M14,3 V8 H19</StreamGeometry>
    <StreamGeometry x:Key="IconDrop">M12,3 L12,14 M8,10 L12,14 L16,10 M5,17 H19 V21 H5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconEye">M2.5,12 C5,7.5 8.5,5.5 12,5.5 C15.5,5.5 19,7.5 21.5,12 C19,16.5 15.5,18.5 12,18.5 C8.5,18.5 5,16.5 2.5,12 M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z</StreamGeometry>
