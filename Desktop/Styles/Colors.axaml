<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ArtemisInkColor">#0A0E14</Color>
            <Color x:Key="ArtemisRaisedColor">#121A24</Color>
            <Color x:Key="ArtemisCardColor">#182230</Color>
            <Color x:Key="ArtemisTextColor">#E8EEF4</Color>
            <Color x:Key="ArtemisMutedColor">#8B9BB0</Color>
            <Color x:Key="ArtemisAccentColor">#2DD4BF</Color>
            <Color x:Key="ArtemisAccentSoftColor">#332DD4BF</Color>
            <Color x:Key="ArtemisSuccessColor">#3DDC97</Color>
            <Color x:Key="ArtemisWarningColor">#F59E0B</Color>
            <Color x:Key="ArtemisDangerColor">#E85D5D</Color>
            <Color x:Key="ArtemisBorderColor">#14FFFFFF</Color>
            <Color x:Key="ArtemisOverlayColor">#990A0E14</Color>
            <Color x:Key="ArtemisOnAccentColor">#0A0E14</Color>
            <Color x:Key="SystemAccentColor">#2DD4BF</Color>
            <Color x:Key="SystemAccentColorDark1">#25C4B0</Color>
            <Color x:Key="SystemAccentColorDark2">#1AA898</Color>
            <Color x:Key="SystemAccentColorDark3">#148F82</Color>
            <Color x:Key="SystemAccentColorLight1">#5EE0D0</Color>
            <Color x:Key="SystemAccentColorLight2">#99EDE3</Color>
            <Color x:Key="SystemAccentColorLight3">#C5F6F0</Color>

            <SolidColorBrush x:Key="ArtemisInkBrush" Color="{StaticResource ArtemisInkColor}"/>
            <SolidColorBrush x:Key="ArtemisRaisedBrush" Color="{StaticResource ArtemisRaisedColor}"/>
            <SolidColorBrush x:Key="ArtemisCardBrush" Color="{StaticResource ArtemisCardColor}"/>
            <SolidColorBrush x:Key="ArtemisTextBrush" Color="{StaticResource ArtemisTextColor}"/>
            <SolidColorBrush x:Key="ArtemisMutedBrush" Color="{StaticResource ArtemisMutedColor}"/>
            <SolidColorBrush x:Key="ArtemisAccentBrush" Color="{StaticResource ArtemisAccentColor}"/>
            <SolidColorBrush x:Key="ArtemisAccentSoftBrush" Color="{StaticResource ArtemisAccentSoftColor}"/>
            <SolidColorBrush x:Key="ArtemisSuccessBrush" Color="{StaticResource ArtemisSuccessColor}"/>
            <SolidColorBrush x:Key="ArtemisWarningBrush" Color="{StaticResource ArtemisWarningColor}"/>
            <SolidColorBrush x:Key="ArtemisDangerBrush" Color="{StaticResource ArtemisDangerColor}"/>
            <SolidColorBrush x:Key="ArtemisBorderBrush" Color="{StaticResource ArtemisBorderColor}"/>
            <SolidColorBrush x:Key="ArtemisOverlayBrush" Color="{StaticResource ArtemisOverlayColor}"/>
            <SolidColorBrush x:Key="ArtemisOnAccentBrush" Color="{StaticResource ArtemisOnAccentColor}"/>
            <SolidColorBrush x:Key="ArtemisDangerSoftBrush" Color="#33E85D5D"/>
            <SolidColorBrush x:Key="ArtemisSuccessSoftBrush" Color="#223DDC97"/>
            <SolidColorBrush x:Key="ArtemisWarningSoftBrush" Color="#33F59E0B"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="ArtemisInkColor">#F3F6F9</Color>
            <Color x:Key="ArtemisRaisedColor">#FFFFFF</Color>
            <Color x:Key="ArtemisCardColor">#FFFFFF</Color>
            <Color x:Key="ArtemisTextColor">#0A0E14</Color>
            <Color x:Key="ArtemisMutedColor">#5B6B7C</Color>
            <Color x:Key="ArtemisAccentColor">#0F766E</Color>
            <Color x:Key="ArtemisAccentSoftColor">#1A0F766E</Color>
            <Color x:Key="ArtemisSuccessColor">#0F9F6E</Color>
            <Color x:Key="ArtemisWarningColor">#B45309</Color>
            <Color x:Key="ArtemisDangerColor">#C53030</Color>
            <Color x:Key="ArtemisBorderColor">#1A0A0E14</Color>
            <Color x:Key="ArtemisOverlayColor">#660A0E14</Color>
            <Color x:Key="ArtemisOnAccentColor">#F3F6F9</Color>
            <Color x:Key="SystemAccentColor">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark1">#0C5F59</Color>
            <Color x:Key="SystemAccentColorDark2">#0A4F4A</Color>
            <Color x:Key="SystemAccentColorDark3">#083F3B</Color>
            <Color x:Key="SystemAccentColorLight1">#2A9A91</Color>
            <Color x:Key="SystemAccentColorLight2">#5BB8B0</Color>
            <Color x:Key="SystemAccentColorLight3">#9ED6D1</Color>

            <SolidColorBrush x:Key="ArtemisInkBrush" Color="{StaticResource ArtemisInkColor}"/>
            <SolidColorBrush x:Key="ArtemisRaisedBrush" Color="{StaticResource ArtemisRaisedColor}"/>
            <SolidColorBrush x:Key="ArtemisCardBrush" Color="{StaticResource ArtemisCardColor}"/>
            <SolidColorBrush x:Key="ArtemisTextBrush" Color="{StaticResource ArtemisTextColor}"/>
            <SolidColorBrush x:Key="ArtemisMutedBrush" Color="{StaticResource ArtemisMutedColor}"/>
            <SolidColorBrush x:Key="ArtemisAccentBrush" Color="{StaticResource ArtemisAccentColor}"/>
            <SolidColorBrush x:Key="ArtemisAccentSoftBrush" Color="{StaticResource ArtemisAccentSoftColor}"/>
            <SolidColorBrush x:Key="ArtemisSuccessBrush" Color="{StaticResource ArtemisSuccessColor}"/>
            <SolidColorBrush x:Key="ArtemisWarningBrush" Color="{StaticResource ArtemisWarningColor}"/>
            <SolidColorBrush x:Key="ArtemisDangerBrush" Color="{StaticResource ArtemisDangerColor}"/>
            <SolidColorBrush x:Key="ArtemisBorderBrush" Color="{StaticResource ArtemisBorderColor}"/>
            <SolidColorBrush x:Key="ArtemisOverlayBrush" Color="{StaticResource ArtemisOverlayColor}"/>
            <SolidColorBrush x:Key="ArtemisOnAccentBrush" Color="{StaticResource ArtemisOnAccentColor}"/>
            <SolidColorBrush x:Key="ArtemisDangerSoftBrush" Color="#22C53030"/>
            <SolidColorBrush x:Key="ArtemisSuccessSoftBrush" Color="#220F9F6E"/>
            <SolidColorBrush x:Key="ArtemisWarningSoftBrush" Color="#22B45309"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <StreamGeometry x:Key="IconLock">M6,8 V7 A6,6 0 0 1 18,7 V8 H19.5 A1.5,1.5 0 0 1 21,9.5 V20.5 A1.5,1.5 0 0 1 19.5,22 H4.5 A1.5,1.5 0 0 1 3,20.5 V9.5 A1.5,1.5 0 0 1 4.5,8 H6 M8,8 V7 A4,4 0 0 1 16,7 V8 M12,13 A2,2 0 1 0 12,17 A2,2 0 1 0 12,13 Z</StreamGeometry>
