 <Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:Artemis.Desktop.ViewModels"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
         x:Class="Artemis.Desktop.Views.MainWindow"
         x:DataType="vm:MainWindowViewModel"
         Icon="/Assets/avalonia-logo.ico"
            Title="Artemis Desktop">
   
        <DockPanel>
            <!-- Navigation Bar -->
            <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Content="Encrypt" 
                            Command="{Binding ShowEncryptCommand}"
                            Width="100" HorizontalContentAlignment="Center"/>
                    <Button Content="Decrypt" 
                            Command="{Binding ShowDecryptCommand}"
                            Width="100" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
   
            <!-- Main Content Area -->
            <ContentControl Content="{Binding CurrentView}" Margin="10" />
        </DockPanel>
   
    </Window>