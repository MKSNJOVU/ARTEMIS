 <Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:Artemis.Desktop.ViewModels"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
         x:Class="Artemis.Desktop.Views.MainWindow"
         x:DataType="vm:MainWindowViewModel"
         Icon="/Assets/avalonia-logo.ico"
            Title="Artemis Desktop">
   
        <DockPanel>
            <!-- Navigation Bar -->
            <Border DockPanel.Dock="Top" Background="#1E3A5F" Padding="10">
                <Grid ColumnDefinitions="*, Auto, *">
                    <!-- Navigation Buttons (Centered) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="Encrypt"
								Foreground=""
                                Command="{Binding ShowEncryptCommand}"
                                Width="100" HorizontalContentAlignment="Center"/>
                        <Button Content="Decrypt" 
                                Command="{Binding ShowDecryptCommand}"
								Foreground=""
                                Width="100" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Security Tool (Right-aligned) -->
                    <Button Grid.Column="2" 
                            Content="Wipe Clipboard" 
                            Command="{Binding WipeClipboardCommand}"
                            HorizontalAlignment="Right"
                            Background="#FFE0E0" 
                            Foreground="#D32F2F"
                            ToolTip.Tip="Clear sensitive data from the system clipboard"/>
                </Grid>
            </Border>
   
            <!-- Main Content Area -->
            <ContentControl Content="{Binding CurrentView}" Margin="10" />
        </DockPanel>
   
    </Window>