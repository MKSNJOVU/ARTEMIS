<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Artemis.Desktop.ViewModels"
             xmlns:controls="using:Artemis.Desktop.Controls"
             xmlns:models="using:Artemis.Desktop.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Artemis.Desktop.Views.EncryptionView"
             x:DataType="vm:EncryptionViewModel">

    <StackPanel MaxWidth="720" Spacing="16">
        <TextBlock Text="Encrypt files" Classes="PageTitle"/>
        <TextBlock Text="Lock one or more files locally. The password never leaves this device."
                   Classes="Helper"/>

        <Border Classes="Callout">
            <TextBlock Text="All encryption runs on this machine. Nothing is uploaded."
                       TextWrapping="Wrap"/>
        </Border>

        <Border Classes="Card">
            <StackPanel Spacing="12">
                <TextBlock Text="Files" Classes="SectionLabel"/>
                <controls:FileDropZone Placeholder="Drop files to encrypt"
                                       ClickCommand="{Binding SelectFileCommand}"
                                       FilesDroppedCommand="{Binding AddDroppedFilesCommand}"
                                       IsEnabled="{Binding !IsEncrypting}"/>
                <controls:FileChipList Files="{Binding SelectedFiles}"
                                       RemoveCommand="{Binding RemoveFileCommand}"
                                       IsVisible="{Binding HasFiles}"/>

                <StackPanel Spacing="6" IsVisible="{Binding HasRecentFiles}">
                    <TextBlock Text="Recent" Classes="Helper"/>
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RecentFileEntry">
                                <Button Classes="Ghost"
                                        Margin="0,0,8,4"
                                        Content="{Binding FileName}"
                                        Command="{Binding $parent[UserControl].((vm:EncryptionViewModel)DataContext).AddRecentFileCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Path}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="Card">
            <StackPanel Spacing="10">
                <TextBlock Text="Password" Classes="SectionLabel"/>
                <controls:SecurePasswordBox SecurePassword="{Binding Password, Mode=TwoWay}"
                                            Watermark="Enter password"/>
                <controls:SecurePasswordBox SecurePassword="{Binding PasswordConfirm, Mode=TwoWay}"
                                            Watermark="Confirm password"/>
                <TextBlock Text="{Binding PasswordError}"
                           Foreground="{DynamicResource ArtemisDangerBrush}"
                           IsVisible="{Binding PasswordError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding ShowProgress}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}"/>
            <TextBlock Text="{Binding StatusMessage}" Classes="Helper"/>
        </StackPanel>

        <controls:InfoBanner Message="{Binding BannerMessage}"
                             Kind="{Binding BannerKind}"
                             ActionContent="Reveal in folder"
                             ActionCommand="{Binding RevealOutputCommand}"/>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="Primary"
                    Content="Encrypt"
                    Command="{Binding EncryptCommand}"
                    AutomationProperties.Name="Encrypt files"/>
            <Button Classes="Ghost"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding IsEncrypting}"
                    AutomationProperties.Name="Cancel encryption"/>
        </StackPanel>
    </StackPanel>
</UserControl>
