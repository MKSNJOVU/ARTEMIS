<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:Artemis.Desktop.Services"
             x:Class="Artemis.Desktop.Controls.SecurePasswordBox"
             x:Name="Root">
    <Grid>
        <TextBox x:Name="Input"
                 PlaceholderText="{Binding #Root.Watermark}"
                 PasswordChar="{Binding #Root.PasswordMask}"
                 services:SecurityHelper.SecurePassword="{Binding #Root.SecurePassword, Mode=TwoWay}"
                 AutomationProperties.Name="{Binding #Root.Watermark}"/>
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,4,0"
                Classes="Icon"
                Click="OnToggleVisibility"
                ToolTip.Tip="{Binding #Root.ToggleTip}"
                AutomationProperties.Name="{Binding #Root.ToggleTip}">
            <PathIcon Width="16"
                      Height="16"
                      Data="{Binding #Root.ToggleIcon}"/>
        </Button>
    </Grid>
</UserControl>
